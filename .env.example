# Zammad image (built by GitHub Actions, pushed to GHCR)
ZAMMAD_IMAGE=ghcr.io/deenyoro/zammad-kc:latest

# PostgreSQL
POSTGRES_USER=zammad
POSTGRES_PASS=changeme
POSTGRES_DB=zammad
POSTGRES_DB_CREATE=true

# Redis
REDIS_PASS=changeme

# Elasticsearch
ES_JAVA_OPTS=-Xms2g -Xmx2g

# Memcached
MEMCACHED_SIZE=256

# Nginx
NGINX_SERVER_SCHEME=http
NGINX_PORT=8080
