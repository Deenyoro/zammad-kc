<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('FreePBX') %></h1>
  </div>
  <div class="page-header-meta">
    <a class="btn btn--success js-new"><%- @T('Add Connection') %></a>
  </div>
</div>

<div class="page-content">
  <p class="text-muted" style="max-width: 700px;">
    <%- @T('RingCentral rings first. Calls it does not answer are forwarded to FreePBX, where your team rings. Zammad reads call activity from FreePBX here and replies by text through RingCentral, or through FreePBX itself once text messaging is switched on below.') %>
  </p>

  <h2 style="margin-top: 30px;"><%- @T('Missed Call Handling') %></h2>
  <table class="settings-list" style="max-width: 700px;">
    <tr>
      <td style="width: 280px;">
        <span><%- @T('Create Ticket on Missed Call') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Automatically create a ticket when your team misses an inbound call on FreePBX.') %></p>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="missed_call_ticket" value="true" <% if @settings.missed_call_ticket: %>checked<% end %>>
        </label>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Log Every Call as a Closed Ticket') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('File inbound calls that reached FreePBX directly (not through RingCentral) as closed phone tickets for reporting. Calls forwarded from RingCentral are logged by the RingCentral integration, including which extension answered.') %></p>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="call_history_ticket" value="true" <% if @settings.call_history_ticket: %>checked<% end %>>
        </label>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Missed Call Ticket Title') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Use {phone} for the caller phone number.') %></p>
      </td>
      <td>
        <input type="text" name="missed_call_ticket_title" class="form-control" value="<%= @settings.missed_call_ticket_title %>" style="width: 300px;">
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Auto-Reply SMS on Missed Call') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Send an SMS to the caller when your team misses their call. Sent through RingCentral.') %></p>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="missed_call_autoreply" value="true" <% if @settings.missed_call_autoreply: %>checked<% end %>>
        </label>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Reply From Number') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Which of your numbers the reply is texted from.') %></p>
      </td>
      <td>
        <select name="missed_call_autoreply_from" class="form-control" style="width: 300px;">
          <option value="" <% if !@settings.missed_call_autoreply_from: %>selected<% end %>><%- @T('Default RingCentral number') %></option>
          <% for number in @numbers: %>
            <option value="<%= number.number %>" <% if String(number.number) is @settings.missed_call_autoreply_from: %>selected<% end %>><%= number.label %></option>
          <% end %>
        </select>
        <% if @numbers.length is 0: %>
          <p class="text-muted" style="margin: 4px 0 0;"><%- @T('No texting numbers are available yet. Connect a RingCentral SMS account, or switch on FreePBX text messaging below.') %></p>
        <% end %>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Auto-Reply Message') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('The SMS message sent to callers when their call is missed.') %></p>
      </td>
      <td>
        <textarea name="missed_call_autoreply_message" class="form-control" rows="3" style="width: 300px;"><%= @settings.missed_call_autoreply_message %></textarea>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Call About Unfixed Escalations') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Phone a human when a ticket escalation goes unfixed. The PBX holds calls overnight and resumes in the morning.') %></p>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="escalation_call_enabled" value="true" <% if @settings.escalation_call_enabled: %>checked<% end %>>
        </label>
      </td>
    </tr>
  </table>
  <button class="btn btn--primary js-saveMissedCallSettings" style="margin-top: 10px;"><%- @T('Save Missed Call Settings') %></button>

  <h2 style="margin-top: 30px;"><%- @T('Text Messaging (SMS/MMS)') %></h2>
  <p class="text-muted" style="max-width: 700px;">
    <%- @T('Texts go through the KC PBX connector, which reads and sends them with the SMS module on the PBX (Sangoma SMS with SIPStation numbers, or the smsconnector module with a third-party carrier). Incoming texts open or continue tickets, agents reply from the ticket, and texts sent from UCP or Sangoma Connect are captured as notes. While this is on, "New SMS Message (FreePBX)" appears in the + menu and the PBX numbers can be used for missed-call replies.') %>
  </p>
  <table class="settings-list" style="max-width: 700px;">
    <tr>
      <td style="width: 280px;">
        <span><%- @T('Enable Text Messaging') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Polls the connector every minute; the connector can also push texts to the webhook below.') %></p>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="sms_enabled" value="true" <% if @settings.sms_enabled: %>checked<% end %>>
        </label>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Default SMS Number') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Number preselected when an agent starts a new FreePBX text.') %></p>
      </td>
      <td>
        <select name="sms_default_number" class="form-control" style="width: 300px;">
          <option value="" <% if !@settings.sms_default_number: %>selected<% end %>><%- @T('First number the PBX reports') %></option>
          <% for entry in @pbxNumbers: %>
            <option value="<%= entry.number %>" <% if String(entry.number) is @settings.sms_default_number: %>selected<% end %>><%= entry.number %><% if entry.label: %> (<%= entry.label %>)<% end %><% if entry.extension: %> — ext <%= entry.extension %><% end %></option>
          <% end %>
        </select>
        <% if @pbxNumbers.length is 0: %>
          <p class="text-muted" style="margin: 4px 0 0;"><%- @T('No texting numbers reported yet. Add a connection and press Test; the connector lists the numbers its SMS module can send from.') %></p>
        <% end %>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Ticket Title Template') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Use {phone} for the sender phone number.') %></p>
      </td>
      <td>
        <input type="text" name="sms_ticket_title_template" class="form-control" value="<%= @settings.sms_ticket_title_template %>" style="width: 300px;">
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Thread Window') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Hours before a new ticket is created for the same phone number. 0 = one ticket per conversation.') %></p>
      </td>
      <td>
        <input type="number" name="sms_thread_window_hours" class="form-control form-control--small" value="<%= @settings.sms_thread_window_hours %>" min="0" max="8760" style="width: 80px;">
        <span class="text-muted"><%- @T('hours') %></span>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Context Messages') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Earlier messages of the conversation attached as an internal note when the integration opens a new ticket. 0 = off.') %></p>
      </td>
      <td>
        <input type="number" name="sms_context_messages" class="form-control form-control--small" value="<%= @settings.sms_context_messages %>" min="0" max="50" style="width: 80px;">
        <span class="text-muted"><%- @T('messages') %></span>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Webhook URL') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Point the connector at this address for instant delivery. It authenticates with the connection token in the X-KC-Token header.') %></p>
      </td>
      <td>
        <input type="text" class="form-control" value="<%= @smsWebhookUrl %>" readonly onclick="this.select()" style="width: 300px;">
      </td>
    </tr>
  </table>
  <button class="btn btn--primary js-saveSmsSettings" style="margin-top: 10px;"><%- @T('Save Text Messaging Settings') %></button>

  <h2 style="margin-top: 30px;"><%- @T('Connections') %></h2>
  <p class="text-muted" style="max-width: 700px;">
    <%- @T('To be told when a connection breaks, tick it on the API Health Check page. Zammad then checks it every five minutes and opens a ticket if it stops answering, closing the ticket again once it recovers.') %>
  </p>
  <% if @channels.length is 0: %>
    <table class="settings-list settings-list--stretch settings-list--placeholder">
      <thead><tr><th><%- @T('No FreePBX connection configured yet.') %></th></tr></thead>
    </table>
  <% end %>
  <% for channel in @channels: %>
    <% options = channel.options || {} %>
    <div class="action <% if channel.active isnt true: %>is-inactive<% end %>" data-id="<%= channel.id %>">
      <% if options.last_connection_error: %>
        <div class="alert alert--danger" style="margin-bottom: 8px;">
          <strong><%- @T('Connection Error') %>:</strong> <%= options.last_connection_error %>
        </div>
      <% end %>
      <div class="action-flow action-flow--row">
        <div class="action-block action-block--flex">
          <%- @Icon('status', if options.last_connection_error then 'error-color inline' else if channel.active then 'supergood-color inline' else 'error-color inline') %>
          <%= options.label || 'FreePBX' %>
          <span class="text-muted"><%= options.base_url %></span>
          <% if (options.sms_numbers || []).length: %>
            <span class="text-muted"> · <%- @T('texting from') %> <%= (entry.number for entry in options.sms_numbers).join(', ') %></span>
          <% end %>
        </div>
        <div class="action-block action-block--flex">
          <div class="btn btn--danger btn--secondary js-deleteConnection"><%- @T('Delete') %></div>
          <% if channel.active: %>
            <div class="btn btn--secondary js-disableConnection"><%- @T('Disable') %></div>
          <% else: %>
            <div class="btn btn--secondary js-enableConnection"><%- @T('Enable') %></div>
          <% end %>
          <div class="btn btn--secondary js-testConnection"><%- @T('Test') %></div>
          <div class="btn js-editConnection"><%- @T('Edit') %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
