<form>
  <div class="form-group">
    <label><%- @T('Account') %></label>
    <p class="form-control-static">
      <%= @options.user_display_name || @options.phone_number || '-' %>
      <% if @options.user_email: %>
        <br><span class="text-muted"><%= @options.user_email %></span>
      <% end %>
    </p>
  </div>

  <div class="form-group">
    <label for="phone_number"><%- @T('Phone Number') %></label>
    <% if @options.available_phone_numbers && @options.available_phone_numbers.length > 1: %>
      <select name="phone_number" id="phone_number" class="form-control">
        <% for num in @options.available_phone_numbers: %>
          <option value="<%= num %>" <% if num is @options.phone_number: %>selected<% end %>><%= num %></option>
        <% end %>
      </select>
      <p class="help-text"><%- @T('Select which phone number to use for sending and receiving SMS.') %></p>
    <% else: %>
      <p class="form-control-static text-muted"><%= @options.phone_number || '-' %></p>
    <% end %>
  </div>

  <div class="form-group">
    <label for="group_id"><%- @T('Destination Group') %></label>
    <select name="group_id" id="group_id" class="form-control">
      <% for group in @groups: %>
        <option value="<%= group.id %>" <% if group.id is @channel.group_id: %>selected<% end %>><%= group.displayName() %></option>
      <% end %>
    </select>
    <p class="help-text"><%- @T('Incoming SMS messages will create tickets in this group.') %></p>
  </div>

  <div class="form-group">
    <label for="thread_window_hours"><%- @T('Thread Window (hours)') %></label>
    <input type="number" name="thread_window_hours" id="thread_window_hours" class="form-control" value="<%= @options.thread_window_hours || 24 %>" min="0">
    <p class="help-text"><%- @T('Messages within this window are grouped into the same ticket. Set to 0 for a single ongoing ticket per phone number.') %></p>
  </div>

  <div class="form-group">
    <label for="poll_cutoff_date"><%- @T('Poll Cutoff Date') %></label>
    <input type="datetime-local" name="poll_cutoff_date" id="poll_cutoff_date" class="form-control" value="<%= @options.poll_cutoff_date || '' %>">
    <p class="help-text"><%- @T('If set, only messages created after this date will be imported. Leave empty to import all historical messages.') %></p>
  </div>
</form>
