<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('API Health Check') %></h1>
  </div>
</div>

<div class="page-content">

  <h2><%- @T('Ticket Settings') %></h2>
  <p class="text-muted"><%- @T('Configure how alert tickets are created when an API connection fails.') %></p>
  <table class="settings-list" style="max-width: 700px;">
    <tr>
      <td style="width: 200px;">
        <span><%- @T('Group') %></span>
      </td>
      <td>
        <select name="group_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Default (Users)') %></option>
          <% for group in @groups: %>
            <option value="<%= group.id %>" <% if String(@settings.group_id) is String(group.id): %>selected<% end %>><%= group.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Priority') %></span>
      </td>
      <td>
        <select name="priority_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Default (high)') %></option>
          <% for priority in @priorities: %>
            <option value="<%= priority.id %>" <% if String(@settings.priority_id) is String(priority.id): %>selected<% end %>><%= priority.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Owner') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Optional') %></p>
      </td>
      <td>
        <select name="owner_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Unassigned') %></option>
          <% for user in @admins: %>
            <option value="<%= user.id %>" <% if String(@settings.owner_id) is String(user.id): %>selected<% end %>><%= user.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
  </table>

  <hr>

  <h2><%- @T('Discord Bot Health Check') %></h2>
  <p class="text-muted"><%- @T('Monitors the Discord bot process. Checks the health endpoint at a configurable interval. After consecutive failures exceeding the threshold, an alert ticket is created automatically.') %></p>
  <table class="settings-list" style="max-width: 700px;">
    <tr>
      <td style="width: 200px;">
        <span><%- @T('Enabled') %></span>
      </td>
      <td>
        <label class="inline-label">
          <input type="checkbox" name="discord_bot_enabled" value="true" <% if @discordBot.enabled: %>checked<% end %>>
          <%- @T('Enable Discord bot health monitoring') %>
        </label>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Health URL') %></span>
      </td>
      <td>
        <input type="text" name="discord_bot_url" class="form-control" style="width: 400px;" value="<%= @discordBot.url %>" placeholder="http://zammad-discord-bot:3100/healthz">
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Check Interval') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Seconds') %></p>
      </td>
      <td>
        <input type="number" name="discord_bot_interval" class="form-control" style="width: 100px;" value="<%= @discordBot.interval %>" min="10" step="1">
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Failure Threshold') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Consecutive failures before alert') %></p>
      </td>
      <td>
        <input type="number" name="discord_bot_failure_threshold" class="form-control" style="width: 100px;" value="<%= @discordBot.failure_threshold %>" min="1" step="1">
        <% downtime = (@discordBot.failure_threshold || 4) * (@discordBot.interval || 30) %>
        <p class="text-muted" style="margin: 4px 0 0;"><%- @T('Alert after ~%s seconds of downtime', downtime) %></p>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Priority') %></span>
      </td>
      <td>
        <select name="discord_bot_priority_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Default (highest available)') %></option>
          <% for priority in @priorities: %>
            <option value="<%= priority.id %>" <% if String(@discordBot.priority_id) is String(priority.id): %>selected<% end %>><%= priority.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Group') %></span>
      </td>
      <td>
        <select name="discord_bot_group_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Default (same as API health check)') %></option>
          <% for group in @groups: %>
            <option value="<%= group.id %>" <% if String(@discordBot.group_id) is String(group.id): %>selected<% end %>><%= group.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr>
      <td>
        <span><%- @T('Owner') %></span>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Optional') %></p>
      </td>
      <td>
        <select name="discord_bot_owner_id" class="form-control" style="width: 300px;">
          <option value=""><%- @T('Unassigned') %></option>
          <% for user in @admins: %>
            <option value="<%= user.id %>" <% if String(@discordBot.owner_id) is String(user.id): %>selected<% end %>><%= user.displayName() %></option>
          <% end %>
        </select>
      </td>
    </tr>
  </table>

  <hr>

  <h2><%- @T('Monitored Channels') %></h2>
  <p class="text-muted"><%- @T('Select which API connections to monitor. Health checks run every 5 minutes.') %></p>

  <% if @channels.length: %>
    <table class="table table-striped table-hover" style="max-width: 800px;">
      <thead>
        <tr>
          <th style="width: 40px;">
            <input type="checkbox" class="js-selectAll">
          </th>
          <th><%- @T('Type') %></th>
          <th><%- @T('Account Name') %></th>
        </tr>
      </thead>
      <tbody>
        <% for ch in @channels: %>
          <tr>
            <td>
              <input type="checkbox" class="js-channelCheckbox" value="<%= ch.id %>" <% if @monitoredIds.indexOf(ch.id) isnt -1: %>checked<% end %>>
            </td>
            <td><%= ch.area_label %></td>
            <td><%= ch.account_name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else: %>
    <div class="well">
      <%- @T('No active API channels found. Connect a Microsoft Graph Email, Teams Chat, or RingCentral SMS account first.') %>
    </div>
  <% end %>

  <div style="margin-top: 20px;">
    <button class="btn btn--primary js-save"><%- @T('Save Settings') %></button>
    <button class="btn js-checkNow" style="margin-left: 10px;"><%- @T('Check Now') %></button>
  </div>

</div>
