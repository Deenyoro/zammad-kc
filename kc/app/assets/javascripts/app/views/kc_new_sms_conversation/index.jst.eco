<div class="main flex">
  <div class="page-header">
    <div class="page-header-title">
      <h1><%- @T('New SMS Message (RingCentral)') %></h1>
    </div>
  </div>

  <div class="page-content">
    <form class="js-smsForm">
      <div class="form-group">
        <label for="kc-sms-recipient"><%- @T('Recipient') %></label>
        <div class="controls" style="position:relative;">
          <input id="kc-sms-recipient" type="text" class="form-control js-recipientSearch" placeholder="<%- @Ti('Search by name or phone number...') %>" autocomplete="off">
          <a href="#" class="js-clearRecipient" style="display:none; position:absolute; right:10px; top:8px; color:var(--text-muted); text-decoration:none; font-size:16px;" title="<%- @Ti('Clear recipient') %>">&times;</a>
          <div class="js-recipientResults" style="display:none; border:1px solid var(--border); max-height:200px; overflow-y:auto; position:absolute; z-index:100; background:var(--background-primary); color:var(--text-normal); width:100%; border-radius:3px; box-shadow:0 6px 12px rgba(0,0,0,.175);"></div>
        </div>
      </div>

      <div class="form-group">
        <label for="kc-sms-phone"><%- @T('Phone Number') %> <span class="text-danger">*</span></label>
        <input id="kc-sms-phone" type="tel" class="form-control js-phoneNumber" name="phone_number" placeholder="+1234567890" required>
        <input type="hidden" class="js-customerId" name="customer_id" value="">
      </div>

      <div class="form-group">
        <label for="kc-sms-from"><%- @T('From Number') %> <span class="text-danger">*</span></label>
        <select id="kc-sms-from" class="form-control js-fromNumber" name="channel_id">
          <option value=""><%- @T('Loading...') %></option>
        </select>
      </div>

      <div class="form-group">
        <label for="kc-sms-group"><%- @T('Group') %></label>
        <select id="kc-sms-group" class="form-control js-group" name="group_id">
          <% for group in @groups: %>
            <option value="<%= group.id %>"<%= ' selected' if group.id is @defaultGroupId %>><%= group.displayName() %></option>
          <% end %>
        </select>
      </div>

      <div class="form-group">
        <label for="kc-sms-body"><%- @T('Message') %> <span class="text-danger">*</span></label>
        <textarea id="kc-sms-body" class="form-control js-body" name="body" rows="5" placeholder="<%- @Ti('Type your SMS message...') %>" required></textarea>
      </div>

      <div class="form-group">
        <label class="checkbox-replacement" style="display:inline-block; cursor:pointer;">
          <input type="checkbox" class="js-skipSend" name="skip_send" value="1">
          <%- @T("Don't send initial SMS (create ticket only)") %>
        </label>
        <p class="text-muted" style="margin: 2px 0 0;"><%- @T('The ticket will be created with SMS routing so replies are sent as texts, but the initial message will not be texted to the recipient.') %></p>
      </div>

      <div class="form-group">
        <button type="submit" class="btn btn--primary js-submit"><%- @T('Send SMS') %></button>
        <span class="js-loading" style="display:none;"><span class="loading icon"></span> <span class="js-loadingText"><%- @T('Sending...') %></span></span>
      </div>

      <div class="js-error alert alert--danger" style="display:none;"></div>
    </form>
  </div>
</div>
