<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('Teams Chat') %></h1>
  </div>
  <div class="page-header-meta">
    <a class="btn btn--success js-new"><%- @T('Add Account') %></a>
  </div>
</div>

<div class="page-content">
  <% if !@channels.length: %>
    <table class="settings-list settings-list--stretch settings-list--placeholder">
      <thead><tr><th><%- @T('No Teams Chat accounts configured yet.') %>
    </table>
  <% else: %>
    <% for channel in @channels: %>
      <% options = channel.options || {} %>
      <div class="action <% if channel.active isnt true: %>is-inactive<% end %>" data-id="<%= channel.id %>">
        <div class="action-block action-row">
          <h2>
            <%- @Icon('status', if channel.active then 'supergood-color inline' else 'error-color inline') %>
            <%= options.user_display_name || options.user_email || '-' %>
            <% if options.user_email: %>
              <span class="text-muted"><%= options.user_email %></span>
            <% end %>
          </h2>
        </div>
        <div class="action-flow action-flow--row">
          <div class="action-block">
            <h3><%- @T('Tenant') %></h3>
            <%= options.tenant_id || '-' %>
          </div>
          <%- @Icon('arrow-right', 'action-flow-icon') %>
          <div class="action-block">
            <h3><%- @T('Group') %></h3>
            <% if channel.group_id: %>
              <% group = App.Group.find(channel.group_id) %>
              <%= group?.displayName() || '-' %>
            <% else: %>
              -
            <% end %>
          </div>
        </div>
        <div class="action-controls">
          <div class="btn btn--danger btn--secondary js-deleteAccount"><%- @T('Delete') %></div>
          <% if channel.active is true: %>
            <div class="btn btn--secondary js-disableAccount"><%- @T('Disable') %></div>
          <% else: %>
            <div class="btn btn--secondary js-enableAccount"><%- @T('Enable') %></div>
          <% end %>
          <div class="btn js-editAccount"><%- @T('Edit') %></div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
