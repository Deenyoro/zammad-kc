<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('Teams Chat') %></h1>
  </div>
  <div class="page-header-meta">
    <a class="btn btn--success js-new"><%- @T('Add Account') %></a>
  </div>
</div>

<div class="page-content">
  <div class="kc-teams-settings" style="margin-bottom: 20px;">
    <h2><%- @T('Settings') %></h2>
    <table class="settings-list" style="max-width: 700px;">
      <tr>
        <td style="width: 280px;">
          <span><%- @T('Ticket Title Template') %></span>
          <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Use {user_name} for the sender name.') %></p>
        </td>
        <td>
          <input type="text" name="ticket_title_template" class="form-control" value="<%= @settings.ticket_title_template %>" style="width: 300px;">
        </td>
      </tr>
      <tr>
        <td>
          <span><%- @T('Thread Window') %></span>
          <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Hours before a new ticket is created for the same chat. 0 = one ticket per chat.') %></p>
        </td>
        <td>
          <input type="number" name="thread_window_hours" class="form-control form-control--small" value="<%= @settings.thread_window_hours %>" min="0" max="8760" style="width: 80px;">
          <span class="text-muted"><%- @T('hours') %></span>
        </td>
      </tr>
      <tr>
        <td>
          <span><%- @T('Active Chat Lookback') %></span>
          <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Chats with recent tickets are polled every ~30 seconds.') %></p>
        </td>
        <td>
          <input type="number" name="active_lookback_hours" class="form-control form-control--small" value="<%= @settings.active_lookback_hours %>" min="1" max="168" style="width: 80px;">
          <span class="text-muted"><%- @T('hours') %></span>
        </td>
      </tr>
      <tr>
        <td>
          <span><%- @T('Discovery Interval') %></span>
          <p class="text-muted" style="margin: 2px 0 0;"><%- @T('How often to scan for new chats from Teams.') %></p>
        </td>
        <td>
          <input type="number" name="discovery_interval_minutes" class="form-control form-control--small" value="<%= @settings.discovery_interval_minutes %>" min="1" max="60" style="width: 80px;">
          <span class="text-muted"><%- @T('minutes') %></span>
        </td>
      </tr>
      <tr>
        <td>
          <span><%- @T('Deactivate Stale Users') %></span>
          <p class="text-muted" style="margin: 2px 0 0;"><%- @T('Deactivate Zammad users no longer found in Azure AD during directory sync.') %></p>
        </td>
        <td>
          <input type="checkbox" name="deactivate_stale" <% if @settings.deactivate_stale: %>checked<% end %>>
        </td>
      </tr>
    </table>
    <button class="btn btn--primary js-saveSettings" style="margin-top: 10px;"><%- @T('Save Settings') %></button>
  </div>

  <hr>
  <% if !@channels.length: %>
    <table class="settings-list settings-list--stretch settings-list--placeholder">
      <thead><tr><th><%- @T('No Teams Chat accounts configured yet.') %>
    </table>
  <% else: %>
    <% for channel in @channels: %>
      <% options = channel.options || {} %>
      <div class="action <% if channel.active isnt true: %>is-inactive<% end %>" data-id="<%= channel.id %>">
        <div class="action-block action-row">
          <h2>
            <%- @Icon('status', if channel.active then 'supergood-color inline' else 'error-color inline') %>
            <%= options.user_display_name || options.user_email || '-' %>
            <% if options.user_email: %>
              <span class="text-muted"><%= options.user_email %></span>
            <% end %>
          </h2>
        </div>
        <div class="action-flow action-flow--row">
          <div class="action-block">
            <h3><%- @T('Tenant') %></h3>
            <%= options.tenant_id || '-' %>
          </div>
          <%- @Icon('arrow-right', 'action-flow-icon') %>
          <div class="action-block">
            <h3><%- @T('Group') %></h3>
            <% if channel.group_id: %>
              <% group = App.Group.find(channel.group_id) %>
              <%= group?.displayName() || '-' %>
            <% else: %>
              -
            <% end %>
          </div>
        </div>
        <% if options.directory_sync: %>
          <div class="action-block" style="margin-top: 8px;">
            <h3><%- @T('Directory Sync') %></h3>
            <% if options.last_directory_sync: %>
              <% sync = options.last_directory_sync %>
              <span class="text-muted">
                <%- @T('Last synced') %>: <%= sync.completed_at %>
                &mdash; <%= sync.users_created %> <%- @T('created') %>,
                <%= sync.users_updated %> <%- @T('updated') %><% if sync.users_deactivated: %>,
                <%= sync.users_deactivated %> <%- @T('deactivated') %><% end %>
              </span>
            <% else: %>
              <span class="text-muted"><%- @T('Never synced') %></span>
            <% end %>
          </div>
        <% end %>
        <div class="action-controls">
          <div class="btn btn--danger btn--secondary js-deleteAccount"><%- @T('Delete') %></div>
          <% if channel.active is true: %>
            <div class="btn btn--secondary js-disableAccount"><%- @T('Disable') %></div>
          <% else: %>
            <div class="btn btn--secondary js-enableAccount"><%- @T('Enable') %></div>
          <% end %>
          <% if options.directory_sync: %>
            <div class="btn btn--secondary js-syncDirectory"><%- @T('Sync Now') %></div>
          <% end %>
          <div class="btn btn--secondary js-reauthenticate"><%- @T('Reauthenticate') %></div>
          <div class="btn js-editAccount"><%- @T('Edit') %></div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
