<form>
  <div class="form-group">
    <label><%- @T('Account') %></label>
    <p class="form-control-static">
      <%= @options.user_display_name || @options.user_email || '-' %>
      <% if @options.user_email: %>
        <br><span class="text-muted"><%= @options.user_email %></span>
      <% end %>
    </p>
  </div>

  <div class="form-group">
    <label><%- @T('Tenant ID') %></label>
    <p class="form-control-static text-muted"><%= @options.tenant_id || '-' %></p>
  </div>

  <div class="form-group">
    <label for="group_id"><%- @T('Destination Group') %></label>
    <select name="group_id" id="group_id" class="form-control">
      <% for group in @groups: %>
        <option value="<%= group.id %>" <% if group.id is @channel.group_id: %>selected<% end %>><%= group.displayName() %></option>
      <% end %>
    </select>
    <p class="help-text"><%- @T('Incoming Teams chat messages will create tickets in this group.') %></p>
  </div>

  <div class="form-group">
    <label for="thread_window_hours"><%- @T('Thread Window (hours)') %></label>
    <input type="number" name="thread_window_hours" id="thread_window_hours" class="form-control" value="<%= @options.thread_window_hours || 24 %>" min="0">
    <p class="help-text"><%- @T('Messages within this window are grouped into the same ticket. Set to 0 for a single ongoing ticket per chat.') %></p>
  </div>

  <div class="form-group">
    <label for="poll_cutoff_date"><%- @T('Poll Cutoff Date') %></label>
    <input type="datetime-local" name="poll_cutoff_date" id="poll_cutoff_date" class="form-control" value="<%= @options.poll_cutoff_date || '' %>">
    <p class="help-text"><%- @T('If set, only messages created after this date will be imported. Leave empty to import all historical messages.') %></p>
  </div>

  <hr>
  <h3><%- @T('Directory Sync') %></h3>

  <div class="form-group">
    <label for="organization_id"><%- @T('Organization') %></label>
    <select name="organization_id" id="organization_id" class="form-control">
      <option value="" <% if !@options.organization_id: %>selected<% end %>><%- @T('(Auto-create from tenant)') %></option>
      <% for org in @organizations: %>
        <option value="<%= org.id %>" <% if org.id is @options.organization_id: %>selected<% end %>><%= org.displayName() %></option>
      <% end %>
    </select>
    <p class="help-text"><%- @T('Imported Azure AD users will be assigned to this organization.') %></p>
  </div>

  <div class="form-group">
    <label class="inline-label">
      <input type="checkbox" name="directory_sync" value="true" <% if @options.directory_sync: %>checked<% end %>>
      <%- @T('Enable Directory Sync') %>
    </label>
    <p class="help-text"><%- @T('When enabled, this channel participates in Azure AD user import.') %></p>
  </div>
</form>
