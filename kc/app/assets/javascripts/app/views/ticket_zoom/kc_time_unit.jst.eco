<div>
  <label><%- @T('Accounted Time') %></label>
  <div class="accounted-time-value-container">
    <div class="accounted-time-value-row">
      <div class="accounted-time-value-item"><strong><%- @T('Total') %></strong></div>
      <div class="accounted-time-value-item"><strong><%= @timeUnit(@ticket.time_unit) %></strong></div>
      <% if @displayUnit: %>
      <div class="accounted-time-value-item">
        <span class="text-muted"><%- @T(@displayUnit) %></span>
      </div>
      <% end %>
    </div>

    <% for group in @agentGroups: %>
    <div class="accounted-time-value-row" style="margin-top: 8px;">
      <div class="accounted-time-value-item"><strong><%= group.agent_name %></strong></div>
      <div class="accounted-time-value-item"><strong><%= @timeUnit(group.total) %></strong></div>
      <% if @displayUnit: %>
      <div class="accounted-time-value-item">
        <span class="text-muted"><%- @T(@displayUnit) %></span>
      </div>
      <% end %>
    </div>
    <% visibleEntries = if @showAllEntries then group.entries else group.entries.slice(0, 5) %>
    <% for entry in visibleEntries: %>
    <div class="accounted-time-value-row" style="padding-left: 10px;">
      <div class="accounted-time-value-item text-muted"><%= entry.type_name %></div>
      <div class="accounted-time-value-item"><%= @timeUnit(entry.time_unit) %></div>
      <% if @editable: %>
      <div class="accounted-time-value-item">
        <a href="#" class="js-deleteEntry text-muted" data-entry-id="<%= entry.id %>" title="<%- @T('Delete') %>">&times;</a>
      </div>
      <% end %>
    </div>
    <% end %>
    <% end %>

    <% if @showMore: %>
    <div style="margin-top: 4px;">
      <a href="#" class="js-showMoreEntries"><%- @T('show more') %></a>
    </div>
    <% end %>

    <% if @editable: %>
    <div style="margin-top: 8px;">
      <a href="#" class="js-toggleAddForm">
        <% if @showAddForm: %>
          <%- @T('Cancel') %>
        <% else: %>
          <%- @T('+ Add Time Entry') %>
        <% end %>
      </a>
    </div>

    <% if @showAddForm: %>
    <div style="margin-top: 8px;">
      <div class="form-group">
        <label class="formGroup-label"><%- @T('Agent') %></label>
        <select class="form-control form-control--small js-agentSelect">
          <% for agent in @agents: %>
          <option value="<%= agent.id %>"><%= agent.displayName() %></option>
          <% end %>
        </select>
      </div>
      <% if @types.length: %>
      <div class="form-group">
        <label class="formGroup-label"><%- @T('Activity Type') %></label>
        <select class="form-control form-control--small js-typeSelect">
          <option value=""><%- @T('None') %></option>
          <% for type in @types: %>
          <option value="<%= type.id %>"><%= type.name %></option>
          <% end %>
        </select>
      </div>
      <% end %>
      <div class="form-group">
        <label class="formGroup-label"><%- @T('Time') %></label>
        <input type="number" class="form-control form-control--small js-timeInput" step="0.25" min="0.25" placeholder="0.00">
      </div>
      <button class="btn btn--primary btn--small js-addEntry"><%- @T('Add') %></button>
    </div>
    <% end %>
    <% end %>
  </div>
</div>
