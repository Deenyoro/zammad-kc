# Zammad image (built by GitLab CI from kc/gitlab-ci.yml into the private GitLab registry;
# `docker login gitlabreg.kawa.link` with a read_registry token first).
# Pin a version tag (see kc/VERSION) instead of latest for anything you keep.
ZAMMAD_IMAGE=gitlabreg.kawa.link/dean/zammad-kc/zammad-kc:latest

# PostgreSQL (replace the changeme values before the first start)
POSTGRES_USER=zammad
POSTGRES_PASS=changeme
POSTGRES_DB=zammad
POSTGRES_DB_CREATE=true

# Redis
REDIS_PASS=changeme

# Elasticsearch
ES_JAVA_OPTS=-Xms2g -Xmx2g

# Memcached
MEMCACHED_SIZE=256

# Nginx
NGINX_SERVER_SCHEME=http
NGINX_PORT=8080
